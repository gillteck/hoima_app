# Browser + SSR (publishable key is safe in the client bundle)
VITE_SUPABASE_URL=https://<new-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<new publishable / anon key>
SUPABASE_URL=https://<new-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=<new publishable / anon key>
VITE_SUPABASE_PROJECT_ID=<new-ref>
SUPABASE_PROJECT_ID=<new-ref>

# Server only. Set in your host's secret settings. Never commit, never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=<new service role / secret key>
